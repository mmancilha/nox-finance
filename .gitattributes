# Normaliza todos os arquivos de texto para LF no repositório
* text=auto eol=lf

# Arquivos que devem ser sempre LF
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.sh   text eol=lf
*.sql  text eol=lf
*.env* text eol=lf
*.example text eol=lf

# Binários — sem conversão
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
*.lock binary
