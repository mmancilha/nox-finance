# ═══════════════════════════════════════════════════════════════
#  Nox - .env.example
#  Copie este arquivo para .env e preencha APENAS o que for usar.
#  NUNCA commite .env com secrets reais.
# ═══════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Database (Postgres local via docker-compose) ───────────────
DATABASE_URL=postgresql+asyncpg://nox:nox_dev@localhost:5432/nox
DATABASE_ECHO=false

# Variáveis que o docker-compose da infra usa (opcionais, têm defaults)
POSTGRES_USER=nox
POSTGRES_PASSWORD=nox_dev
POSTGRES_DB=nox
POSTGRES_PORT=5432

# ── Redis / Celery ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
# Se quiser broker/backend separados do cache, setar abaixo:
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# ── Auth (NextAuth v5 + JWT) ───────────────────────────────────
# Gere com:  openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE-ME-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=gere-com-openssl-rand-base64-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth (Sprint 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Encryption (tokens bancários, AES-256) ────────────────────
# Em produção: openssl rand -base64 32  (32 bytes decodificados)
ENCRYPTION_KEY=CHANGE-ME-32-bytes-for-dev-only-!!

# ── Pluggy (Open Finance Brasil), Sprint 3 ────────────────────
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai

# ── OpenAI, Sprint 4 ──────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_MINI=gpt-4o-mini
OPENAI_MODEL_FULL=gpt-4o

# ── Resend (email), Sprint 5 ──────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nox <nao-responda@nox.finance>

# ── Supabase (Postgres gerenciado + Storage em produção) ───────
# Em dev você pode ignorar, usamos o Postgres do docker-compose.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Stripe (Fase 2, monetização) ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Sentry (observabilidade) ───────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── CORS ───────────────────────────────────────────────────────
# Lista separada por vírgula. Não inclua espaço.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
